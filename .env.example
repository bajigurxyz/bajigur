# ---------- apps/api ----------
PORT=3002

# ---------- apps/web (:3000) ----------
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
# Required for sign-in. Without it the app runs wallet-free: the catalogue is
# public, but nothing can be unlocked.
NEXT_PUBLIC_PRIVY_APP_ID=
# REQUIRED for payments. This app's Privy wallets run in a TEE, where the only
# way to grant server-side signing is to add a key quorum as a signer. Create
# one in the Privy dashboard under Authorization keys; it hands you an id and a
# private key. The id goes here, the private key in PRIVY_AUTHORIZATION_KEY.
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# The ENS parent every creator name sits under.
NEXT_PUBLIC_ENS_NAME=bajigur.eth

# ---------- apps/landingpage (:3001) ----------
# Where the landing page sends Gallery / Connect / Start selling.
OAUTH_SECRET=
NEXT_PUBLIC_MCP_URL=http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Privy (server side, apps/api) ----------
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=

# ---------- Hedera (x402-gated service) ----------
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
X402_FACILITATOR_URL=
X402_PAY_TO_ADDRESS=
X402_PAY_TO_KEY=
HCS_TOPIC_ID=

# ---------- agent wallets (Privy delegated signing) ----------
PRIVY_AUTHORIZATION_KEY=
PRIVY_SIGNER_ID=
# Either the PEM from the Privy dashboard, or the app's JWKS URL. Prefer the
# JWKS URL: it keeps working across a signing-key rotation, where a static PEM
# silently becomes the wrong key.
# https://auth.privy.io/api/v1/apps/<app id>/jwks.json
PRIVY_VERIFICATION_KEY=
AGENT_TOKEN_SECRET=
ADMIN_KEY=
AGENT_CAP_USD=1
AGENT_CAP_HBAR=5
AGENT_FUND_HBAR=5
AGENT_FUND_USDC=1

# ---------- apps/mcp (Claude Desktop, pays with HEDERA_OPERATOR_*) ----------
BAJIGUR_API_URL=http://localhost:3002
X402_MAX_SPEND_USD=1
X402_PAY_WITH=usdc
X402_MAX_SPEND_HBAR=5
ENS_AGENT_NAME=
BAJIGUR_AGENT_TOKEN=

# ---------- contracts (forge script / deploy) ----------
# Never commit real values.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
DEPLOYER_PRIVATE_KEY=
PROMPT_MINTER=
PROMPT_REGISTRY_ADDRESS=
ERC8004_AGENT_ID=
# ERC-8004 registries on Hedera testnet; the defaults in src/reputation.ts are the deployed singletons.
ERC8004_REPUTATION_REGISTRY=
ERC8004_AGENT_URI=

# ---------- ENS (ENSv2 beta on Sepolia; creator/agent identity) ----------
ENS_NAME=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_SUBREGISTRY=
ENS_RESOLVER=
BAJIGUR_REGISTRAR=

# Published prompts (Railway Postgres). Without it, publishing is disabled.
DATABASE_URL=
# Extra hosts allowed for previewMedia, comma separated (*.r2.dev is always allowed).
PREVIEW_MEDIA_HOSTS=
# Prompts one wallet may publish per hour (default 5).
PUBLISH_PER_HOUR=
