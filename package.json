{
  "name": "bajigur",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && turbo run lint",
    "format": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "hedera:associate": "bun apps/api/scripts/associate-usdc.ts",
    "hedera:topic": "bun apps/api/scripts/create-topic.ts",
    "hedera:register": "bun --env-file=.env apps/api/scripts/register-prompts.ts",
    "buy": "bun --env-file=.env apps/mcp/scripts/buy.ts",
    "privy:spike": "bun --env-file=.env apps/mcp/scripts/privy-spike.ts",
    "privy:associate": "bun --env-file=.env apps/mcp/scripts/privy-associate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.3.14",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
